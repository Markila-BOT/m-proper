{
  "openapi": "3.1.0",
  "info": {
    "title": "api",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/properties": {
      "get": {
        "tags": [
          "properties"
        ],
        "summary": "List all properties (active first, then newest created_at).",
        "operationId": "list_properties",
        "responses": {
          "200": {
            "description": "Properties fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_Vec_Property"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_TupleUnit"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "properties"
        ],
        "summary": "Create a new property.",
        "operationId": "create_property",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePropertyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Property created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_Property"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_TupleUnit"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_TupleUnit"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "properties"
        ],
        "summary": "Delete without a property id: answer the spec's 400 envelope.",
        "operationId": "delete_property_without_id",
        "responses": {
          "400": {
            "description": "Missing property id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_TupleUnit"
                }
              }
            }
          }
        }
      }
    },
    "/properties/{id}": {
      "delete": {
        "tags": [
          "properties"
        ],
        "summary": "Delete a property by id.",
        "operationId": "delete_property",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Property id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Property deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_TupleUnit"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_TupleUnit"
                }
              }
            }
          },
          "404": {
            "description": "Property not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_TupleUnit"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope_TupleUnit"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiEnvelope_Property": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "id",
              "name",
              "address",
              "type",
              "isActive",
              "createdAt"
            ],
            "properties": {
              "address": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "isActive": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "$ref": "#/components/schemas/PropertyType"
              },
              "units": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int32"
              }
            }
          },
          "message": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "ApiEnvelope_TupleUnit": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "data": {
            "default": null
          },
          "message": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "ApiEnvelope_Vec_Property": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "address",
                "type",
                "isActive",
                "createdAt"
              ],
              "properties": {
                "address": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "isActive": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "$ref": "#/components/schemas/PropertyType"
                },
                "units": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "int32"
                }
              }
            }
          },
          "message": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "CreatePropertyRequest": {
        "type": "object",
        "required": [
          "name",
          "address",
          "type"
        ],
        "properties": {
          "address": {
            "type": "string"
          },
          "isActive": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "units": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "Property": {
        "type": "object",
        "required": [
          "id",
          "name",
          "address",
          "type",
          "isActive",
          "createdAt"
        ],
        "properties": {
          "address": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "isActive": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/PropertyType"
          },
          "units": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        }
      },
      "PropertyType": {
        "type": "string",
        "enum": [
          "residential",
          "commercial",
          "lot"
        ]
      },
      "TupleUnit": {
        "default": null
      }
    }
  },
  "tags": [
    {
      "name": "properties",
      "description": "Property management API"
    }
  ]
}