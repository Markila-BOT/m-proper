# Postgres connection string from Supabase
# Dashboard → Project Settings → Database → Connection string → URI
# NOT the Project URL (https://xxxx.supabase.co) and NOT the anon/service API keys.
#
# Example shapes (Session pooler — preferred on IPv4-only networks):
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Direct db.* host is often IPv6-only and will fail on many home networks.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# API listen port (default 3000)
PORT=3000

# Optional: RUST_LOG=info,api=debug
