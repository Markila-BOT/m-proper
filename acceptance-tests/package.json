{
  "name": "m-proper-acceptance-tests",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "cucumber-js acceptance harness for m-proper — executes the effective OpenSpec spec against the running application",
  "license": "MIT",
  "scripts": {
    "test": "cucumber-js",
    "test:specs": "HARNESS_SCOPE=specs cucumber-js -p specs",
    "lint:specs": "node extract-gherkin.cjs && gherkin-lint .extracted"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.1",
    "cheerio": "^1.2.0",
    "gherkin-lint": "^4.2.4",
    "glob": "^14.0.6",
    "semver": "^7.8.6"
  }
}
